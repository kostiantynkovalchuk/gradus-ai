# Tenderlot Bot — Environment Variables
# Copy this file to .env and fill in values for local dev.
# In Replit, set these as Secrets instead.

# REQUIRED: Telegram bot token from @BotFather (use a separate DEV bot, not production!)
TENDERLOT_BOT_TELEGRAM_BOT_TOKEN=your-bot-token-here

# Bot's own state database (SQLite in dev, Neon PostgreSQL in production)
TENDERLOT_BOT_BOT_DATABASE_URL=sqlite+aiosqlite:///./tenderlot_bot.db

# Tenderlot read-only database (SQLite mock in dev, MariaDB in production)
TENDERLOT_BOT_TENDERLOT_DATABASE_URL=sqlite+aiosqlite:///./tenderlot_mock.db

# Bot run mode: "polling" for dev, "webhook" for production
TENDERLOT_BOT_BOT_MODE=polling

# How often to check for new tenders (seconds)
TENDERLOT_BOT_POLL_INTERVAL_SECONDS=30

# Max tenders to process per poll cycle
TENDERLOT_BOT_POLL_BATCH_SIZE=50

# Environment identifier
TENDERLOT_BOT_ENVIRONMENT=replit_dev

# Log level: DEBUG | INFO | WARNING | ERROR
TENDERLOT_BOT_LOG_LEVEL=INFO

# Log format: "text" for dev, "json" for production
TENDERLOT_BOT_LOG_FORMAT=text
